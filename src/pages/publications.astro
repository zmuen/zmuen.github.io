---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publications, publicationCategories } from "../data/publications";

const groups = publicationCategories
  .map((category) => ({
    ...category,
    items: publications
      .filter((pub) => pub.category === category.key)
      .sort((a, b) => b.year - a.year),
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout title="Publications" description="Selected publications">
  <section class="page-header publications-header">
    <p class="eyebrow">Publications</p>
    <h1>Publications</h1>
  </section>

  {groups.map((group) => (
    <section class="publication-group">
      <h2 class="publication-group-title">{group.label}</h2>
      <div class="publication-list">
        {group.items.map((publication) => (
          <article class="publication-item">
            <p class="publication-citation">
              <span>{publication.authors.join(", ")}.</span>{" "}
              <span class="publication-title">"{publication.title}."</span>{" "}
              {publication.venue && <><em>{publication.venue}</em>, </>}
              {publication.year}.{" "}
              {publication.status}
            </p>
            {/* publication.abstract && <p>{publication.abstract}</p> */}
            {publication.link && (
              <p>
                <a href={publication.link}>View publication</a>
              </p>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
